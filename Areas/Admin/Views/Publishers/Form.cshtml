@model PublisherFormViewModel
@{
    var isEdit = Model.Id != 0;
    var formAction = (string)ViewData["FormAction"]!;
    ViewData["Title"] = isEdit ? "Sửa nhà xuất bản" : "Thêm nhà xuất bản";
}
<div class="card"><div class="card-body">
    <h5 class="card-title">Thông tin nhà xuất bản</h5>
    <form asp-action="@formAction" method="post" class="row g-3">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="col-12"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" rows="2"></textarea><span asp-validation-for="Address" class="text-danger small"></span></div>
        <div class="col-12"><button type="submit" class="btn btn-primary">Lưu</button> <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div>
    </form>
</div></div>
