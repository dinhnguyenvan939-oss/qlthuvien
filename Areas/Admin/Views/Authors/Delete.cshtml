@model tblTacGia
@{
    ViewData["Title"] = "Xóa tác giả";
}
<div class="card"><div class="card-body">
    <h5 class="card-title">Xác nhận xóa tác giả</h5>
    <p>Bạn có chắc chắn muốn xóa tác giả <strong>@Model.FullName</strong> không?</p>
    <dl class="row">
        <dt class="col-sm-3">Tiểu sử</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Biography) ? "—" : Model.Biography)</dd>
        <dt class="col-sm-3">Số sách</dt><dd class="col-sm-9">@Model.BookAuthors.Count</dd>
    </dl>
    @if (Model.BookAuthors.Count > 0) { <div class="alert alert-warning">Tác giả đang được gắn với sách nên không thể xóa.</div> }
    <form asp-action="Delete" method="post" class="d-flex gap-2">
        <input type="hidden" name="id" value="@Model.Id" />
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
        <button type="submit" class="btn btn-danger" disabled="@(Model.BookAuthors.Count > 0)"><i class="bi bi-trash"></i> Xác nhận xóa</button>
    </form>
</div></div>
