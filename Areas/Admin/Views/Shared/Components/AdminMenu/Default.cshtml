@model IReadOnlyCollection<AdminMenu>
@{
    var roots = Model.Where(x => x.ItemLevel == 1).OrderBy(x => x.ItemOrder);
}
<ul class="sidebar-nav" id="sidebar-nav">
    @foreach (var item in roots)
    {
        var children = Model.Where(x => x.ParentLevel == item.AdminMenuID).OrderBy(x => x.ItemOrder).ToList();
        <li class="nav-item">
            @if (children.Count > 0)
            {
                var target = item.IdName ?? $"menu-{item.AdminMenuID}";
                <a class="nav-link collapsed" data-bs-target="#@target" data-bs-toggle="collapse" href="#">
                    <i class="@(item.Icon ?? "bi bi-circle")"></i><span>@item.ItemName</span><i class="bi bi-chevron-down ms-auto"></i>
                </a>
                <ul id="@target" class="nav-content collapse" data-bs-parent="#sidebar-nav">
                    @foreach (var child in children)
                    {
                        <li><a href="@Url.Action(child.ActionName, child.ControllerName, new { area = child.AreaName })"><i class="@(child.Icon ?? "bi bi-circle")"></i><span>@child.ItemName</span></a></li>
                    }
                </ul>
            }
            else
            {
                <a class="nav-link collapsed" href="@Url.Action(item.ActionName, item.ControllerName, new { area = item.AreaName })">
                    <i class="@(item.Icon ?? "bi bi-circle")"></i><span>@item.ItemName</span>
                </a>
            }
        </li>
    }
</ul>