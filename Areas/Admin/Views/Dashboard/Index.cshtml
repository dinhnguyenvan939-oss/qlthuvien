@{
    ViewData["Title"] = "Bảng điều khiển";
}
<section class="section dashboard">
    <div class="row">
        <div class="col-lg-8">
            <div class="row">
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card users-card">
                        <div class="card-body">
                            <h5 class="card-title">Tài khoản <span>| hệ thống</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center"><i class="bi bi-people"></i></div>
                                <div class="ps-3"><h6>@ViewBag.UserCount</h6><span class="text-muted small">tài khoản</span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card categories-card">
                        <div class="card-body">
                            <h5 class="card-title">Danh mục <span>| sách</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center"><i class="bi bi-collection"></i></div>
                                <div class="ps-3"><h6>@ViewBag.CategoryCount</h6><a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="small">Quản lý danh mục</a></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card genres-card">
                        <div class="card-body">
                            <h5 class="card-title">Thể loại <span>| sách</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center"><i class="bi bi-bookmarks"></i></div>
                                <div class="ps-3"><h6>@ViewBag.GenreCount</h6><a asp-area="Admin" asp-controller="Genres" asp-action="Index" class="small">Quản lý thể loại</a></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Phạm vi triển khai <span>| các sprint</span></h5>
                    <div class="activity">
                        <div class="activity-item d-flex"><div class="activite-label">SP1</div><i class="bi bi-circle-fill activity-badge text-primary align-self-start"></i><div class="activity-content">Quản lý tài khoản, vai trò và quyền truy cập.</div></div>
                        <div class="activity-item d-flex"><div class="activite-label">SP1.2</div><i class="bi bi-circle-fill activity-badge text-success align-self-start"></i><div class="activity-content">Quản lý danh mục sách và thể loại theo danh mục.</div></div>
                        <div class="activity-item d-flex"><div class="activite-label">SP2</div><i class="bi bi-circle-fill activity-badge text-secondary align-self-start"></i><div class="activity-content">Nhà xuất bản, tác giả, sách và tài liệu số.</div></div>
                        <div class="activity-item d-flex"><div class="activite-label">SP3+</div><i class="bi bi-circle-fill activity-badge text-secondary align-self-start"></i><div class="activity-content">Mượn trả, quá hạn và thống kê sẽ triển khai ở các sprint tiếp theo.</div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Truy cập nhanh</h5>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-outline-primary w-100 mb-3"><i class="bi bi-people me-1"></i> Tài khoản & phân quyền</a>
                    }
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-outline-primary w-100 mb-3"><i class="bi bi-collection me-1"></i> Danh mục sách</a>
                    <a asp-area="Admin" asp-controller="Genres" asp-action="Index" class="btn btn-outline-primary w-100"><i class="bi bi-bookmarks me-1"></i> Thể loại sách</a>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Vai trò trong hệ thống</h5>
                    <div class="activity">
                        <div class="activity-item d-flex"><div class="activite-label">Admin</div><i class="bi bi-circle-fill activity-badge text-primary align-self-start"></i><div class="activity-content">Quản lý tài khoản và toàn bộ cấu hình.</div></div>
                        <div class="activity-item d-flex"><div class="activite-label">Thủ thư</div><i class="bi bi-circle-fill activity-badge text-success align-self-start"></i><div class="activity-content">Quản lý danh mục và thể loại sách.</div></div>
                        <div class="activity-item d-flex"><div class="activite-label">Độc giả</div><i class="bi bi-circle-fill activity-badge text-warning align-self-start"></i><div class="activity-content">Tài khoản người đọc thư viện.</div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
