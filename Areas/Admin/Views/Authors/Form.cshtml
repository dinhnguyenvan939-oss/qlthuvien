@model AuthorFormViewModel
@{
    var isEdit = Model.Id != 0;
    var formAction = (string)ViewData["FormAction"]!;
    ViewData["Title"] = isEdit ? "Sửa tác giả" : "Thêm tác giả";
}
<div class="card"><div class="card-body">
    <h5 class="card-title">Thông tin tác giả</h5>
    <form asp-action="@formAction" method="post" class="row g-3">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-md-8"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
        <div class="col-12"><label asp-for="Biography" class="form-label"></label><textarea asp-for="Biography" class="form-control" rows="4"></textarea><span asp-validation-for="Biography" class="text-danger small"></span></div>
        <div class="col-12"><button type="submit" class="btn btn-primary">Lưu</button> <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div>
    </form>
</div></div>
