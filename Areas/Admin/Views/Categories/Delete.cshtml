@model tblDanhMuc
@{
    ViewData["Title"] = "Xóa danh mục";
}
<div class="card"><div class="card-body">
    <h5 class="card-title">Xác nhận xóa danh mục</h5>
    <p>Bạn có chắc chắn muốn xóa danh mục <strong>@Model.Name</strong> không?</p>
    <dl class="row">
        <dt class="col-sm-3">Tên danh mục</dt><dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Mô tả</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>
        <dt class="col-sm-3">Số thể loại</dt><dd class="col-sm-9">@Model.Genres.Count</dd>
    </dl>
    @if (Model.Genres.Count > 0)
    {
        <div class="alert alert-warning">Danh mục đang có thể loại nên không thể xóa. Hãy xóa hoặc chuyển các thể loại trước.</div>
    }
    <form asp-action="Delete" method="post" class="d-flex gap-2">
        <input type="hidden" name="id" value="@Model.Id" />
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
        <button type="submit" class="btn btn-danger" disabled="@(Model.Genres.Count > 0)"><i class="bi bi-trash"></i> Xác nhận xóa</button>
    </form>
</div></div>
